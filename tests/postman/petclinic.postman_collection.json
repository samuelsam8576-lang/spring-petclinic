    "name": "PetClinic - Testes de API",
    "description": "CT08 e verificação das rotas principais. Rodar com a aplicação em localhost:8080: npx newman run tests/postman/petclinic.postman_collection.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "CT08 - Veterinários (API)",
      "item": [
        {
          "name": "Aquecimento (sem verificação de tempo)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vets"
              ]
            }
          }
        },
        {
          "name": "CT08 - Lista de veterinários em JSON",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vets"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Content-Type é JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "const corpo = pm.response.json();",
                  "pm.test(\"vetList tem 6 veterinários\", function () {",
                  "    pm.expect(corpo.vetList).to.have.lengthOf(6);",
                  "});",
                  "pm.test(\"Helen Leary tem a especialidade radiology\", function () {",
                  "    const helen = corpo.vetList.find(v => v.firstName === \"Helen\" && v.lastName === \"Leary\");",
                  "    pm.expect(helen, \"Helen Leary na lista\").to.exist;",
                  "    pm.expect(helen.specialties.map(s => s.name)).to.include(\"radiology\");",
                  "});",
                  "pm.test(\"Resposta em menos de 500 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
